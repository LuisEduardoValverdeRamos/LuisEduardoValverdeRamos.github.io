---
import { nav, strings, type Locale } from '../i18n/ui';
import { switchTarget } from '../i18n/routes';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const items = nav[locale];
const t = strings[locale];
const target = switchTarget(Astro.url.pathname);
const current = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
---

<a class="skip" href="#contenido">{t.skip}</a>
<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="logo" href={locale === 'es' ? '/' : '/en/'}>
      <span class="logo-full">Luis Valverde Ramos</span>
      <span class="logo-compact mono" aria-hidden="true">LVR</span>
    </a>
    <nav aria-label={locale === 'es' ? 'Navegación principal' : 'Main navigation'}>
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        <li class="switcher">
          <a
            href={target.href}
            lang={locale === 'es' ? 'en' : 'es'}
            aria-label={target.exact ? t.switcherLabel : t.switcherHomeLabel}
          >{t.switcher}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--color-tinta);
    color: var(--color-fondo);
    padding: 10px 16px;
    z-index: 100;
  }
  .skip:focus { left: 0; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-fondo) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--color-linea);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 64px;
  }
  .logo {
    font-family: var(--font-display);
    font-weight: 640;
    font-size: 19px;
    letter-spacing: -0.015em;
    color: var(--color-tinta);
    text-decoration: none;
    white-space: nowrap;
  }
  .logo-compact { display: none; font-size: 15px; letter-spacing: 0.06em; }

  nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    list-style: none;
  }
  nav a {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-tinta);
    text-decoration: none;
    padding: 6px 2px;
    border-bottom: 2px solid transparent;
  }
  nav a:hover { border-bottom-color: var(--color-algarrobo); }
  nav a[aria-current='page'] { border-bottom-color: var(--color-algarrobo); }

  .switcher a {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    border: 1px solid var(--color-linea);
    padding: 5px 10px;
  }
  .switcher a:hover { border-color: var(--color-algarrobo); color: var(--color-algarrobo); }

  /* Barra compacta tras 120px de scroll (§5). La ALTURA DEL HUECO no cambia
     —si cambiara, cada scroll empujaría el contenido y el CLS dejaría de ser 0—:
     solo se compacta el logotipo y se afina la hairline. */
  .site-header[data-compact] .logo-full { display: none; }
  .site-header[data-compact] .logo-compact { display: inline; }
  .site-header[data-compact] { border-bottom-color: var(--color-tinta); }

  @media (max-width: 880px) {
    .logo-full { display: none; }
    .logo-compact { display: inline; }
    nav ul { gap: var(--space-2); flex-wrap: wrap; justify-content: flex-end; }
    nav a { font-size: 14px; }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  let compact = false;
  const onScroll = () => {
    const c = window.scrollY > 120;
    if (c !== compact) {
      compact = c;
      header?.toggleAttribute('data-compact', c);
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
