---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';

// JSON-LD Person (PROMPT §12). ORCID y Scholar entran en sameAs cuando existan.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Luis Valverde Ramos',
  jobTitle: 'Politólogo',
  email: 'mailto:luis.valverde@pucp.edu.pe',
  url: 'https://luiseduardovalverderamos.github.io/',
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Pontificia Universidad Católica del Perú' },
    { '@type': 'CollegeOrUniversity', name: 'Ghent University' },
  ],
  knowsAbout: [
    'Comportamiento electoral',
    'Ciencia social computacional',
    'Infraestructura pública',
    'Debate competitivo',
  ],
  sameAs: [
    'https://github.com/LuisEduardoValverdeRamos',
    'https://www.linkedin.com/in/luisvalverderamos/',
  ],
};
---

<Base
  title="Inicio"
  description="Politólogo (PUCP). Ciencia social computacional sobre elecciones, prensa e infraestructura pública; formación en debate competitivo."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <Home lang="es" />
</Base>
