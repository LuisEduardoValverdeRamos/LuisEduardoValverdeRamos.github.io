---
// Fichas de proyecto en español (PROMPT.md §6, slugs del Apéndice A.4).
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/pages';

export async function getStaticPaths() {
  const fichas = await getCollection('proyectos', (p) => p.data.lang === 'es');
  return fichas.map((entry) => ({ params: { slug: entry.data.slug_es }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const L = t.es;
const d = entry.data;
---

<Base title={d.title} description={d.summary}>
  <article class="wrap ficha">
    <p class="kicker"><a href="/proyectos/">{L.back}</a></p>
    <h1>{d.title}</h1>
    <p class="summary">{d.summary}</p>
    <p class="tags">
      <span class="chip mono">{d.status}</span>
      {d.open_data && <span class="chip mono open">{L.openData}</span>}
    </p>

    <dl class="meta">
      <dt class="kicker">{L.problem}</dt>
      <dd>{d.problema}</dd>
      <dt class="kicker">{L.forWhom}</dt>
      <dd>{d.para_quien}</dd>
      <dt class="kicker">{L.data}</dt>
      <dd>{d.datos}</dd>
    </dl>

    <div class="prose"><Content /></div>

    {(d.site || d.repo) && (
      <p class="links">
        {d.site && <a class="more" href={d.site}>{L.visit} →</a>}
        {d.repo && <a class="more" href={`https://github.com/LuisEduardoValverdeRamos/${d.repo}`}>{L.repoLabel} →</a>}
      </p>
    )}
  </article>
</Base>

<style>
  .ficha { padding: var(--space-8) var(--space-3) var(--space-12); max-width: 820px; }
  .ficha h1 { font-size: clamp(30px, 4vw, 44px); margin: var(--space-2) 0 var(--space-3); }
  .summary { font-size: 19px; color: var(--color-tinta-2); }
  .tags { display: flex; gap: 8px; flex-wrap: wrap; margin-top: var(--space-3); }
  .chip { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; border: 1px solid var(--color-linea); padding: 3px 9px; color: var(--color-tinta-2); }
  .chip.open { border-color: var(--color-mar); color: var(--color-mar); }
  .meta { margin: var(--space-6) 0; border-top: 1px solid var(--color-linea); }
  .meta dt { margin-top: var(--space-3); }
  .meta dd { margin: 6px 0 var(--space-2); color: var(--color-tinta-2); }
  .prose { border-top: 1px solid var(--color-linea); padding-top: var(--space-4); }
  .prose :global(p) { margin-bottom: var(--space-2); color: var(--color-tinta-2); }
  .links { display: flex; gap: var(--space-4); margin-top: var(--space-6); flex-wrap: wrap; }
  .more { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid var(--color-linea); padding-bottom: 2px; color: var(--color-tinta); }
  .more:hover { border-bottom-color: var(--color-algarrobo); color: var(--color-algarrobo); }
</style>
